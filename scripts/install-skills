#!/usr/bin/env bash
# Install (symlink or copy) Nimbus agent skills into an agent skills directory.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
skills_dir="$repo_root/skills"

target="${AGENTS_HOME:-$HOME/.agents}/skills"
mode="symlink"   # symlink | copy
force=0
do_list=0
dry_run=0
selected=()

usage() {
  cat <<'EOF'
Usage: install-skills [options] [skill ...]

Options:
  --list             List available skills and exit.
  --dry-run          Print actions without changing files.
  --target DIR       Install into DIR (default: ~/.agents/skills).
  --mode MODE        symlink (default) or copy.
  --force            Replace an existing installed skill.
  -h, --help         Show this help.

With no skill names, all skills are installed.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --list) do_list=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    --target) target="$2"; shift 2 ;;
    --mode) mode="$2"; shift 2 ;;
    --force) force=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "unknown option: $1" >&2; usage; exit 2 ;;
    *) selected+=("$1"); shift ;;
  esac
done

available=()
for d in "$skills_dir"/*/; do
  [ -f "$d/SKILL.md" ] || continue
  available+=("$(basename "$d")")
done

if [ "$do_list" -eq 1 ]; then
  [ "${#available[@]}" -gt 0 ] && printf '%s\n' "${available[@]}"
  exit 0
fi

case "$mode" in symlink|copy) ;; *) echo "invalid --mode: $mode" >&2; exit 2 ;; esac

if [ "${#selected[@]}" -eq 0 ]; then
  if [ "${#available[@]}" -eq 0 ]; then
    echo "no skills found under $skills_dir" >&2
    exit 1
  fi
  selected=("${available[@]}")
fi

missing=()
for name in "${selected[@]}"; do
  src="$skills_dir/$name"
  [ -f "$src/SKILL.md" ] || missing+=("$name")
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "unknown skill(s): ${missing[*]}" >&2
  [ "${#available[@]}" -gt 0 ] && echo "available: ${available[*]}" >&2
  exit 1
fi

if [ "$dry_run" -eq 0 ]; then
  mkdir -p "$target"
fi
for name in "${selected[@]}"; do
  src="$skills_dir/$name"
  dst="$target/$name"
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    if [ "$force" -eq 1 ]; then
      src_real="$(cd "$src" && pwd -P)"
      dst_real=""
      if [ ! -L "$dst" ] && [ -d "$dst" ]; then
        dst_real="$(cd "$dst" 2>/dev/null && pwd -P || true)"
      fi
      if [ "$src_real" = "$dst_real" ]; then
        echo "target is source, skipping: $dst" >&2
        continue
      fi
      [ "$dry_run" -eq 1 ] && echo "rm    $dst" || rm -rf "$dst"
    else
      echo "exists (use --force): $dst" >&2
      continue
    fi
  fi
  if [ "$mode" = "symlink" ]; then
    if [ "$dry_run" -eq 1 ]; then
      echo "would symlink $name -> $dst"
    else
      ln -sfn "$src" "$dst"
      echo "symlink $name -> $dst"
    fi
  else
    if [ "$dry_run" -eq 1 ]; then
      echo "would copy $name -> $dst"
    else
      cp -R "$src" "$dst"
      echo "copy $name -> $dst"
    fi
  fi
done
